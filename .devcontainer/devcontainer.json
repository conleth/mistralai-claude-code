{
  "name": "Claude Code + Mistral",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10"
    }
  },
  "remoteEnv": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "LITELLM_MASTER_KEY": "lcl-local"
  },
  "forwardPorts": [4000],
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && pip install --no-cache-dir litellm",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
