{
  "name": "security-rat-modern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modern Security Requirements Automation Tool - DeepWiki-first, deterministic, OWASP ASVS/SPVS focused",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "bash tools/init.sh",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
